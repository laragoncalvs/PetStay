@model PetStay.Models.HotelDetailsViewModel

@{
    ViewData["Title"] = Model.Hotel.Nome;
}

<style>
    .details-page {
        max-width: 1180px;
        margin: 0 auto;
    }

    .details-image {
        border-radius: 1.25rem;
        height: 420px;
        object-fit: cover;
        width: 100%;
    }

    .details-card, .booking-card {
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 .25rem 1rem rgba(30, 55, 70, .1);
    }

    .booking-card {
        position: sticky;
        top: 1rem;
    }

    .detail-item {
        background: #f4f8f8;
        border-radius: .75rem;
        padding: .85rem 1rem;
    }

    @@media (max-width: 767.98px) {
        .details-image {
            height: 260px;
        }

        .booking-card {
            position: static;
        }
    }
</style>

<div class="details-page py-3 px-4">
    <a asp-controller="Home" asp-action="Index" class="d-inline-flex gap-2 mb-3 text-decoration-none">
        <span aria-hidden="true">&#8592;</span> Voltar para hospedagens
    </a>

    @if (!string.IsNullOrWhiteSpace(Model.Hotel.ImagemUrl))
    {
        <img class="details-image mb-4" src="@Model.Hotel.ImagemUrl" alt="Imagem do @Model.Hotel.Nome" />
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <section class="card details-card p-4 mb-4">
                <div class="d-flex flex-wrap justify-content-between gap-3">
                    <div>
                        <h1 class="display-6 fw-bold mb-2">@Model.Hotel.Nome</h1>
                        <p class="text-muted mb-0">
                            &#128205; @Model.Hotel.Endereco, @Model.Hotel.Cidade@(string.IsNullOrWhiteSpace(Model.Hotel.Estado) ? "" : $" - {Model.Hotel.Estado}")
                        </p>
                    </div>
                    <div class="text-end">
                        <strong class="fs-5">&#9733; @Model.Hotel.Avaliacao.ToString("0.0")</strong>
                        <small class="d-block text-muted">Avaliação dos hóspedes</small>
                    </div>
                </div>
                <hr class="my-4" />
                <h2 class="h4">Sobre esta hospedagem</h2>
                <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.Hotel.Descricao) ? "Nenhuma descrição informada." : Model.Hotel.Descricao)</p>
            </section>

            <section class="card details-card p-4">
                <h2 class="h4 mb-3">Informações da hospedagem</h2>
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    <div class="col">
                        <div class="detail-item">
                            <span class="d-block text-muted small">Capacidade</span>
                            <strong>@Model.Hotel.Capacidade pets</strong>
                        </div>
                    </div>
                    <div class="col">
                        <div class="detail-item">
                            <span class="d-block text-muted small">Telefone</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Hotel.Telefone) ? "Não informado" : Model.Hotel.Telefone)</strong>
                        </div>
                    </div>
                    <div class="col">
                        <div class="detail-item">
                            <span class="d-block text-muted small">E-mail</span>
                            @if (string.IsNullOrWhiteSpace(Model.Hotel.Email))
                            {
                                <strong>Não informado</strong>
                            }
                            else
                            {
                                <a class="text-break" href="mailto:@Model.Hotel.Email">@Model.Hotel.Email</a>
                            }
                        </div>
                    </div>
                    <div class="col">
                        <div class="detail-item">
                            <span class="d-block text-muted small">Status</span>
                            <strong>@(Model.Hotel.Ativo ? "Disponível" : "Indisponível")</strong>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            <aside class="card booking-card p-4">
                <p class="text-muted mb-1">A partir de</p>
                <div class="d-flex align-items-baseline gap-1 mb-4">
                    <strong class="display-6" style="color: #176b87;">@Model.Hotel.Diaria.ToString("C")</strong>
                    <span class="text-muted">/ noite</span>
                </div>
                <form asp-controller="Reservation" asp-action="Create" method="post">
                    <input type="hidden" name="HotelId" value="@Model.Hotel.Id" />

                    <label class="form-label fw-semibold" for="dataEntrada">Data de entrada</label>
                    <input id="dataEntrada" class="form-control mb-3" type="date" name="DataEntrada" value="@Model.DataEntrada?.ToString("yyyy-MM-dd")" required />

                    <label class="form-label fw-semibold" for="dataSaida">Data de saída</label>
                    <input id="dataSaida" class="form-control mb-3" type="date" name="DataSaida" value="@Model.DataSaida?.ToString("yyyy-MM-dd")" required />

                    <label class="form-label fw-semibold" for="petId">Selecionar pet</label>
                    @if (Model.PetsDoTutor.Any())
                    {
                        <select id="petId" class="form-control mb-4" name="PetId" required>
                            <option value="">-- Escolha um pet --</option>
                            @foreach (var pet in Model.PetsDoTutor)
                            {
                                <option value="@pet.Id" selected="@(Model.PetId == pet.Id ? "selected" : null)">@pet.Nome</option>
                            }
                        </select>
                    }
                    else
                    {
                        <div class="alert alert-info mb-4">
                            Você precisa ter pelo menos um pet cadastrado para fazer uma reserva.
                        </div>
                    }

                    <button class="btn w-100 py-2 fw-semibold text-white" style="background-color: #176b87;" type="submit" @(Model.PetsDoTutor.Any() ? "" : "disabled")>Solicitar reserva</button>
                </form>
                <p class="small text-muted text-center mt-3 mb-0">Você não será cobrado agora.</p>
            </aside>
        </div>
    </div>
</div>
