@model List<Reservation>

@{
    ViewData["Title"] = "Reservas Confirmadas - Check-in";
}

<div class="container my-5">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h1 class="fw-bold">Reservas Confirmadas</h1>
            <p class="text-muted">Registre o check-in dos pets que chegaram</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <strong>Nenhuma reserva confirmada</strong>
            <br />
            As reservas aprovadas apareceão aqui para registro de check-in.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Tutor</th>
                        <th>Pet</th>
                        <th>Data Entrada Prevista</th>
                        <th>Data Saída Prevista</th>
                        <th>Valor</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reservation in Model)
                    {
                        <tr>
                            <td>@reservation.Tutor?.Nome</td>
                            <td>@reservation.Pet?.Nome</td>
                            <td>@reservation.DataEntrada.ToString("dd/MM/yyyy")</td>
                            <td>@reservation.DataSaida.ToString("dd/MM/yyyy")</td>
                            <td>@reservation.ValorTotal.ToString("C")</td>
                            <td>
                                <button type="button" class="btn btn-sm px-3 py-2 fw-semibold text-white" 
                                        style="background-color: #176b87; border-radius: 50px; border: none;"
                                        data-bs-toggle="modal" data-bs-target="#checkInModal"
                                        onclick="setCheckInReservationId(@reservation.Id, '@reservation.Pet?.Nome')">
                                    Registrar Check-in
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Check-in -->
<div class="modal fade" id="checkInModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold">Registrar Check-in</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="checkInForm" method="post">
                <div class="modal-body">
                    <p id="petName" class="mb-3"></p>

                    <label class="form-label fw-semibold">Data de Check-in</label>
                    <input type="date" class="form-control mb-3" name="dataCheckIn" required />

                    <label class="form-label fw-semibold">Hora de Check-in</label>
                    <input type="time" class="form-control mb-3" name="horaCheckIn" />

                    <label class="form-label fw-semibold">Observações (opcional)</label>
                    <textarea class="form-control" name="observacoes" rows="3" placeholder="Ex: Pet chegou com comportamento dócil..."></textarea>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn px-4 py-2 fw-semibold" style="border: 1px solid #ccc; border-radius: 50px; background: white; color: #333;" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn px-4 py-2 fw-semibold text-white" style="background-color: #176b87; border-radius: 50px; border: none;">Confirmar Check-in</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setCheckInReservationId(reservationId, petName) {
        const form = document.getElementById('checkInForm');
        form.action = `/Reservation/register-check-in/${reservationId}`;
        document.getElementById('petName').textContent = `Pet: ${petName}`;

        // Definir data atual como padrão
        const today = new Date().toISOString().split('T')[0];
        form.querySelector('[name="dataCheckIn"]').value = today;
        form.querySelector('[name="horaCheckIn"]').value = '14:00';
    }
</script>
