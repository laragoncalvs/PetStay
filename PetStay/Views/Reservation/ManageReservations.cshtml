@model List<Reservation>

@{
    ViewData["Title"] = "Gerenciar Reservas - Check-in e Check-out";
}

<div class="container my-5">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h1 class="fw-bold">Gerenciar Reservas</h1>
            <p class="text-muted">Registre check-in e check-out dos pets em um único painel</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            <strong>Nenhuma reserva para gerenciar</strong>
            <br />
            As reservas confirmadas e em progresso aparecerão aqui.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Tutor</th>
                        <th>Pet</th>
                        <th>Status</th>
                        <th>Data Entrada Prevista</th>
                        <th>Data Saída Prevista</th>
                        <th>Check-in Efetivo</th>
                        <th>Valor</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reservation in Model)
                    {
                        <tr>
                            <td>@reservation.Tutor?.Nome</td>
                            <td>@reservation.Pet?.Nome</td>
                            <td>
                                @if (reservation.Status == StatusReserva.Confirmada)
                                {
                                    <span class="badge bg-warning text-dark">Confirmada</span>
                                }
                                else if (reservation.Status == StatusReserva.EmProgresso)
                                {
                                    <span class="badge bg-info">Em Progresso</span>
                                }
                            </td>
                            <td>@reservation.DataEntrada.ToString("dd/MM/yyyy")</td>
                            <td>@reservation.DataSaida.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (reservation.DataCheckInEfetiva.HasValue)
                                {
                                    <span>@reservation.DataCheckInEfetiva?.ToString("dd/MM/yyyy")</span>
                                    @if (reservation.HoraCheckInEfetiva.HasValue)
                                    {
                                        <span>@reservation.HoraCheckInEfetiva?.ToString(@"hh\:mm")</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@reservation.ValorTotal.ToString("C")</td>
                            <td>
                                @if (reservation.Status == StatusReserva.Confirmada)
                                {
                                    <button type="button" class="btn btn-sm px-3 py-2 fw-semibold text-white" 
                                            style="background-color: #176b87; border-radius: 50px; border: none;"
                                            data-bs-toggle="modal" data-bs-target="#checkInModal"
                                            onclick="setCheckInReservationId(@reservation.Id, '@reservation.Pet?.Nome')">
                                        Fazer Check-in
                                    </button>
                                }
                                else if (reservation.Status == StatusReserva.EmProgresso)
                                {
                                    <button type="button" class="btn btn-sm px-2 py-1 fw-semibold text-white me-2" 
                                            style="background-color: #176b87; border-radius: 50px; border: none;"
                                            data-bs-toggle="modal" data-bs-target="#checkInModal"
                                            onclick="setCheckInReservationId(@reservation.Id, '@reservation.Pet?.Nome')">
                                        Refazer Check-in
                                    </button>
                                    <button type="button" class="btn btn-sm px-2 py-1 fw-semibold text-white" 
                                            style="background-color: #176b87; border-radius: 50px; border: none;"
                                            data-bs-toggle="modal" data-bs-target="#checkOutModal"
                                            onclick="setCheckOutReservationId(@reservation.Id, '@reservation.Pet?.Nome')">
                                        Fazer Check-out
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Check-in -->
<div class="modal fade" id="checkInModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold">Registrar Check-in</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="checkInForm" method="post">
                <div class="modal-body">
                    <p id="petNameCheckIn" class="mb-3"></p>

                    <label class="form-label fw-semibold">Data de Check-in</label>
                    <input type="date" class="form-control mb-3" name="dataCheckIn" required />

                    <label class="form-label fw-semibold">Hora de Check-in</label>
                    <input type="time" class="form-control mb-3" name="horaCheckIn" />

                    <label class="form-label fw-semibold">Observações (opcional)</label>
                    <textarea class="form-control" name="observacoes" rows="3" placeholder="Ex: Pet chegou bem..."></textarea>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn px-4 py-2 fw-semibold" style="border: 1px solid #ccc; border-radius: 50px; background: white; color: #333;" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn px-4 py-2 fw-semibold text-white" style="background-color: #176b87; border-radius: 50px; border: none;">Confirmar Check-in</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Check-out -->
<div class="modal fade" id="checkOutModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold">Registrar Check-out</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="checkOutForm" method="post">
                <div class="modal-body">
                    <p id="petNameCheckOut" class="mb-3"></p>

                    <label class="form-label fw-semibold">Data de Check-out</label>
                    <input type="date" class="form-control mb-3" name="dataCheckOut" required />

                    <label class="form-label fw-semibold">Hora de Check-out</label>
                    <input type="time" class="form-control mb-3" name="horaCheckOut" />

                    <label class="form-label fw-semibold">Observações (opcional)</label>
                    <textarea class="form-control" name="observacoes" rows="3" placeholder="Ex: Pet saiu bem..."></textarea>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn px-4 py-2 fw-semibold" style="border: 1px solid #ccc; border-radius: 50px; background: white; color: #333;" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn px-4 py-2 fw-semibold text-white" style="background-color: #176b87; border-radius: 50px; border: none;">Confirmar Check-out</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setCheckInReservationId(reservationId, petName) {
        const form = document.getElementById('checkInForm');
        form.action = `/Reservation/register-check-in/${reservationId}`;
        document.getElementById('petNameCheckIn').textContent = `Pet: ${petName}`;

        // Definir data atual como padrão
        const today = new Date().toISOString().split('T')[0];
        form.querySelector('[name="dataCheckIn"]').value = today;
        form.querySelector('[name="horaCheckIn"]').value = '14:00';
    }

    function setCheckOutReservationId(reservationId, petName) {
        const form = document.getElementById('checkOutForm');
        form.action = `/Reservation/register-check-out/${reservationId}`;
        document.getElementById('petNameCheckOut').textContent = `Pet: ${petName}`;

        // Definir data atual como padrão
        const today = new Date().toISOString().split('T')[0];
        form.querySelector('[name="dataCheckOut"]').value = today;
        form.querySelector('[name="horaCheckOut"]').value = '11:00';
    }
</script>
