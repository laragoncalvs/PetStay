@model PaymentViewModel

@{
    ViewData["Title"] = "Processo de Pagamento";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="mb-4">Processo de Pagamento</h1>

            <div class="card mb-4">
                <div class="card-header  ">
                    <h5 class="mb-0">Resumo da Reserva</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-6"><strong>Hotel:</strong></div>
                        <div class="col-6 text-end">@Model?.HotelNome</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6"><strong>Pet:</strong></div>
                        <div class="col-6 text-end">@Model?.PetNome</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6"><strong>Check-in:</strong></div>
                        <div class="col-6 text-end">@Model?.DataEntrada.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6"><strong>Check-out:</strong></div>
                        <div class="col-6 text-end">@Model?.DataSaida.ToString("dd/MM/yyyy")</div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-6"><h5>Valor Total:</h5></div>
                        <div class="col-6 text-end"><h5>R$ @Model?.ValorTotal.ToString("F2")</h5></div>
                    </div>
                </div>
            </div>

            <form id="paymentForm">
                <!-- Payment Method Selection -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Selecione a Forma de Pagamento</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="metodoPagamento" id="pix" value="pix" required />
                                <label class="form-check-label" for="pix">
                                    <strong>PIX Instantâneo</strong>
                                    <br />
                                    <small class="text-muted">Rápido e seguro</small>
                                </label>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="metodoPagamento" id="credito" value="cartao_credito" />
                                <label class="form-check-label" for="credito">
                                    <strong>Cartão de Crédito</strong>
                                    <br />
                                    <small class="text-muted">Parcelado em até 12x</small>
                                </label>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="metodoPagamento" id="debito" value="cartao_debito" />
                                <label class="form-check-label" for="debito">
                                    <strong>Cartão de Débito</strong>
                                    <br />
                                    <small class="text-muted">Débito imediato em conta</small>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PIX Payment Section -->
                <div id="pixSection" class="card mb-4" style="display: none;">
                    <div class="card-header ">
                        <h5 class="mb-0">Pagamento via PIX</h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            <strong>Instruções:</strong>
                            <ol>
                                <li>Abra seu aplicativo bancário</li>
                                <li>Escaneie o QR Code abaixo ou copie o código PIX</li>
                                <li>Confirme a transação</li>
                            </ol>
                        </div>
                        <div id="pixContent" class="text-center">
                            <!-- QR Code will be generated here -->
                        </div>
                    </div>
                </div>

                <!-- Credit Card Section -->
                <div id="creditCardSection" class="card mb-4" style="display: none;">
                    <div class="card-header ">
                        <h5 class="mb-0">Dados do Cartão de Crédito</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="nomeCartao" class="form-label">Nome do Titular</label>
                            <input type="text" class="form-control" id="nomeCartao" name="nomeCartao" />
                        </div>
                        <div class="mb-3">
                            <label for="numeroCartao" class="form-label">Número do Cartão (16 dígitos)</label>
                            <input type="text" class="form-control" id="numeroCartao" name="numeroCartao" 
                                placeholder="0000 0000 0000 0000" maxlength="16" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="validadeCartao" class="form-label">Validade (MM/AA)</label>
                                <input type="text" class="form-control" id="validadeCartao" name="validadeCartao" 
                                    placeholder="12/25" maxlength="5" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="cvvCartao" class="form-label">CVV (3 dígitos)</label>
                                <input type="text" class="form-control" id="cvvCartao" name="cvvCartao" 
                                    placeholder="000" maxlength="3" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Terms -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="termos" required />
                            <label class="form-check-label" for="termos">
                                Concordo com os <a href="#">Termos e Condições</a> e a <a href="#">Política de Privacidade</a>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        Confirmar Pagamento
                    </button>
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const form = document.getElementById('paymentForm');
    const pixSection = document.getElementById('pixSection');
    const creditCardSection = document.getElementById('creditCardSection');

    // Show/hide payment method sections
    document.querySelectorAll('input[name="metodoPagamento"]').forEach(radio => {
        radio.addEventListener('change', function() {
            pixSection.style.display = this.value === 'pix' ? 'block' : 'none';
            creditCardSection.style.display = (this.value === 'cartao_credito' || this.value === 'cartao_debito') ? 'block' : 'none';

            if (this.value === 'pix') {
                generatePixQRCode();
            }
        });
    });

    form.addEventListener('submit', async function(e) {
        e.preventDefault();

        const formData = new FormData(form);
        const data = {
            metodoPagamento: formData.get('metodoPagamento'),
            nomeCartao: formData.get('nomeCartao'),
            numeroCartao: formData.get('numeroCartao'),
            validadeCartao: formData.get('validadeCartao'),
            cvvCartao: formData.get('cvvCartao')
        };

        try {
            const response = await fetch('/Payment/confirm-and-pay', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            if (!response.ok) {
                const error = await response.json();
                alert('Erro: ' + (error.message || 'Falha ao processar pagamento'));
                return;
            }

            const result = await response.json();
            alert('Pagamento realizado com sucesso!\nCódigo de transação: ' + result.codigoTransacao);
            window.location.href = result.redirectUrl;
        } catch (error) {
            console.error('Erro:', error);
            alert('Erro ao processar pagamento');
        }
    });

    async function generatePixQRCode() {
        const content = document.getElementById('pixContent');

        // Para PIX, apenas exibir instruções genéricas já que não temos dados reais
        content.innerHTML = `
            <div class="card">
                <div class="card-body">
                    <p class="text-muted"><strong>PIX simplificado</strong></p>
                    <p>Clique em confirmar pagamento para proceder.</p>
                </div>
            </div>
        `;
    }

    function copyToClipboard(button) {
        const code = button.previousElementSibling.textContent;
        navigator.clipboard.writeText(code).then(() => {
            button.textContent = '✓ Copiado!';
            setTimeout(() => button.textContent = 'Copiar', 2000);
        });
    }
</script>
