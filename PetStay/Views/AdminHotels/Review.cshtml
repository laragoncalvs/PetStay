@model PetStay.Models.HotelReviewViewModel

@{
    ViewData["Title"] = "Analisar hotel";
}

<style>
    .review-page {
        max-width: 760px;
        margin: 0 auto;
    }

    .review-card {
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 .5rem 1.5rem rgba(30, 55, 70, .12);
    }

    .review-title {
        color: #176b87;
    }
</style>

<div class="review-page px-4 py-5">
    <div class="text-center mb-4">
        <h1 class="h2 review-title">Analisar cadastro</h1>
        <p class="text-muted mb-0">Confira as informações antes de tomar uma decisão.</p>
    </div>

    <div class="card review-card mb-4">
        <div class="card-body p-4 p-md-5">
            <h2 class="h4 mb-3">@Model.NomeHotel</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Cidade</dt>
                <dd class="col-sm-8">@(Model.Cidade ?? "Não informada")</dd>
                <dt class="col-sm-4">Gestor responsável</dt>
                <dd class="col-sm-8">@(Model.GestorNome ?? "Não informado")</dd>
            </dl>
        </div>
    </div>

    <div class="card review-card">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Review" asp-route-id="@Model.HotelId" method="post">
                <div asp-validation-summary="ModelOnly" class="mb-3" role="alert"></div>

                <fieldset class="mb-4">
                    <legend class="form-label">Decisão</legend>
                    <div class="form-check">
                        <input asp-for="Decisao" class="form-check-input" type="radio" value="1" id="aprovado" />
                        <label class="form-check-label" for="aprovado">Aprovar hotel</label>
                    </div>
                    <div class="form-check">
                        <input asp-for="Decisao" class="form-check-input" type="radio" value="2" id="reprovado" />
                        <label class="form-check-label" for="reprovado">Reprovar hotel</label>
                    </div>
                    <span asp-validation-for="Decisao"></span>
                </fieldset>

                <div class="mb-4">
                    <label asp-for="Justificativa" class="form-label"></label>
                    <textarea asp-for="Justificativa" class="form-control" rows="5" placeholder="Explique os motivos da aprovação ou reprovação."></textarea>
                    <span asp-validation-for="Justificativa"></span>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Voltar</a>
                    <button type="submit" class="btn text-white fw-semibold flex-fill" style="background-color: #176b87;">Registrar decisão</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
