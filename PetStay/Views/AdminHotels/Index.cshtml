@model IEnumerable<PetStay.Models.Hotel>

@{
    ViewData["Title"] = "Aprovação de hotéis";
}

<style>
    .admin-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .admin-card {
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 .5rem 1.5rem rgba(30, 55, 70, .12);
    }

    .admin-title {
        color: #176b87;
    }
</style>

<div class="admin-page px-4 py-5">
    <div class="mb-4">
        <h1 class="h2 admin-title mb-1">Aprovação de hotéis</h1>
        <p class="text-muted mb-0">Analise os cadastros pendentes enviados pelos gestores.</p>
    </div>

    @if (TempData["AdminHotelSuccess"] is string message)
    {
        <div class="alert alert-success" role="alert">@message</div>
    }

    @if (!Model.Any())
    {
        <div class="card admin-card">
            <div class="card-body text-center p-5">
                <h2 class="h4">Nenhum cadastro pendente</h2>
                <p class="text-muted mb-0">Todos os hotéis enviados já foram analisados.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-lg-2 g-4">
            @foreach (var hotel in Model)
            {
                <div class="col">
                    <article class="card admin-card h-100">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between gap-3 mb-3">
                                <div>
                                    <h2 class="h4 mb-1">@hotel.Nome</h2>
                                    <p class="text-muted mb-0">@hotel.Cidade@(string.IsNullOrWhiteSpace(hotel.Estado) ? "" : $" - {hotel.Estado}")</p>
                                </div>
                                <div class="fw-500">Pendente</div>
                            </div>
                            <p class="small mb-2"><strong>Gestor:</strong> @(hotel.Gestor?.Nome ?? "Não informado")</p>
                            <p class="small text-muted flex-grow-1">@(string.IsNullOrWhiteSpace(hotel.Descricao) ? "Sem descrição informada." : hotel.Descricao)</p>
                            <a asp-action="Review" asp-route-id="@hotel.Id" class="btn text-white fw-semibold" style="background-color: #176b87;">Analisar cadastro</a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
