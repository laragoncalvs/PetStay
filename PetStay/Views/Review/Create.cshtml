@model ReviewViewModel

@{
    ViewData["Title"] = "Avaliar Hotel";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h1 class="mb-4">⭐ Avaliar Hotel</h1>

            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Informações da Reserva</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-2">
                        <div class="col-6"><strong>Hotel:</strong></div>
                        <div class="col-6">@Model?.HotelNome</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6"><strong>Pet:</strong></div>
                        <div class="col-6">@Model?.PetNome</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-6"><strong>Período:</strong></div>
                        <div class="col-6">@Model?.DataEntrada.ToString("dd/MM/yyyy") a @Model?.DataSaida.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="row">
                        <div class="col-6"><strong>Valor da Reserva:</strong></div>
                        <div class="col-6">R$ @Model?.ValorTotal.ToString("F2")</div>
                    </div>
                </div>
            </div>

            <form id="reviewForm">
                <input type="hidden" name="reservationId" value="@Model?.ReservationId" />
                <input type="hidden" name="hotelId" value="@Model?.HotelId" />

                <!-- Rating -->
                <div class="card mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Sua Avaliação</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Nota (1 a 5 estrelas) ⭐</label>
                            <div class="star-rating" id="starRating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <input type="radio" name="nota" value="@i" id="star@i" />
                                    <label for="star@i" class="star">★</label>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="tituloAvaliacao" class="form-label">Título (optional)</label>
                            <input type="text" class="form-control" id="tituloAvaliacao" name="tituloAvaliacao" 
                                placeholder="Ex: Excelente hospedagem!" maxlength="100" />
                        </div>

                        <div class="mb-3">
                            <label for="comentario" class="form-label">Comentário da Avaliação</label>
                            <textarea class="form-control" id="comentario" name="comentario" rows="5" 
                                placeholder="Compartilhe sua experiência...&#10;Fale sobre: higiene, conforto, atendimento, segurança do pet, etc." 
                                maxlength="500"></textarea>
                            <small class="form-text text-muted d-block mt-2">
                                <span id="charCount">0</span> / 500 caracteres
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Helpful Tips -->
                <div class="alert alert-light">
                    <h6>💡 Dicas para uma boa avaliação:</h6>
                    <ul class="mb-0">
                        <li>Seja honesto e respeitoso</li>
                        <li>Forneça detalhes sobre sua experiência</li>
                        <li>Mencione pontos positivos e melhorias</li>
                        <li>Ajude outros tutores na tomada de decisão</li>
                    </ul>
                </div>

                <!-- Actions -->
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg">
                        ✓ Enviar Avaliação
                    </button>
                    <a href="@Url.Action("MyReservations", "Reservation")" class="btn btn-outline-secondary">
                        ← Voltar às Minhas Reservas
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .star-rating {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        font-size: 2rem;
        gap: 0.5rem;
    }

    .star-rating input {
        display: none;
    }

    .star-rating label {
        cursor: pointer;
        color: #ddd;
        transition: color 0.2s;
    }

    .star-rating input:checked ~ label,
    .star-rating label:hover,
    .star-rating label:hover ~ label {
        color: #ffc107;
    }
</style>

<script>
    const textarea = document.getElementById('comentario');
    const charCount = document.getElementById('charCount');

    textarea.addEventListener('input', function() {
        charCount.textContent = this.value.length;
    });

    document.getElementById('reviewForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const nota = document.querySelector('input[name="nota"]:checked');
        if (!nota) {
            alert('Por favor, selecione uma nota');
            return;
        }

        const formData = new FormData(this);
        const data = {
            reservationId: parseInt(formData.get('reservationId')),
            hotelId: parseInt(formData.get('hotelId')),
            nota: parseInt(formData.get('nota')),
            tituloAvaliacao: formData.get('tituloAvaliacao'),
            comentario: formData.get('comentario')
        };

        try {
            const response = await fetch('/api/review/create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            if (!response.ok) {
                const error = await response.json();
                alert('Erro: ' + (error.message || 'Falha ao salvar avaliação'));
                return;
            }

            alert('Avaliação registrada com sucesso! Obrigado pelo feedback.');
            window.location.href = '/api/reservation/my-reservations';
        } catch (error) {
            console.error('Erro:', error);
            alert('Erro ao processar avaliação');
        }
    });

    // Set default rating
    document.getElementById('star5').checked = true;
</script>
