@model IEnumerable<PetStay.Models.Pet>

@{
    ViewData["Title"] = "Meus pets";
}

<style>
    .pets-page {
        max-width: 1100px;
        margin: 0 auto;
    }

    .pet-list-card {
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 .5rem 1.5rem rgba(30, 55, 70, .12);
    }

 
</style>

<div class="pets-page px-4 py-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h2 pets-title mb-1">Meus pets</h1>
            <p class="text-muted mb-0">Consulte e mantenha atualizados os dados dos seus pets.</p>
        </div>
        <a asp-action="Create" class="btn text-white fw-semibold" style="background-color: #176b87;">+ Cadastrar pet</a>
    </div>

    @if (TempData["PetSuccess"] is string petSuccess)
    {
        <div class="alert alert-success" role="alert">@petSuccess</div>
    }

    @if (!Model.Any())
    {
        <div class="card pet-list-card">
            <div class="card-body text-center p-5">
                <h2 class="h4">Você ainda não cadastrou nenhum pet</h2>
                <p class="text-muted">Cadastre seu primeiro companheiro para manter os cuidados registrados.</p>
                <a asp-action="Create" class="btn text-white fw-semibold" style="background-color: #176b87;">Cadastrar primeiro pet</a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            @foreach (var pet in Model)
            {
                <div class="col">
                    <article class="card pet-list-card h-100">
                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <h2 style="color: #176b87"  class="h4 mb-1">@pet.Nome</h2>
                                    <p class="text-muted mb-0">@pet.Especie · @pet.Raca</p>
                                </div>
                                <div class="fw-500">@pet.FaixaEtaria</div>
                            </div>

                            <dl class="row small mb-3">
                                <div class="col-6">
                                <dt >Tamanho</dt>
                                <dd class="col-6 ">@pet.Tamanho</dd>
                                </div>
                                <div class="col-6 text-end">
                                    <dt class="text-end">Vacinação</dt>
                                    <dd class=" text-end">@(pet.DeclaracaoVacinacao ? "Declarada" : "Pendente")</dd>
                            </div>

                                </dl>

                            @if (!string.IsNullOrWhiteSpace(pet.CuidadosEspecificos))
                            {
                                <p class="small text-muted flex-grow-1 mb-3">@pet.CuidadosEspecificos</p>
                            }
                            else
                            {
                                <p class="small text-muted flex-grow-1 mb-3">Nenhum cuidado específico informado.</p>
                            }
                            <hr/>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@pet.Id" style="border: 1px solid #176b87" class="btn btn-outline-secondary flex-fill">Editar</a>
                                <form asp-action="Delete" asp-route-id="@pet.Id" method="post" class="flex-fill" onsubmit="return confirm('Deseja realmente excluir este pet?');">
                                    <button type="submit" class="btn btn-outline-danger w-100">Excluir</button>
                                </form>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>

@if (TempData["PetDeleteError"] is string mensagem)
{
    <div class="modal fade" id="modalExclusaoPet" tabindex="-1" aria-labelledby="tituloModalExclusaoPet" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="tituloModalExclusaoPet">Não foi possível excluir o pet</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">@mensagem</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Entendi</button>
                </div>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            new bootstrap.Modal(document.getElementById('modalExclusaoPet')).show();
        });
    </script>
}
