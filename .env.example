# Configurações de Ambiente - PetStay
# Copie este arquivo para .env e atualize com seus valores

# Ambiente: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# String de Conexão do SQL Server
# LOCAL:
ConnectionStrings__DefaultConnection=Server=.\\SQLEXPRESS;Database=PetStayDb;Trusted_Connection=true;TrustServerCertificate=true;

# AZURE SQL (descomente se usar nuvem):
# ConnectionStrings__DefaultConnection=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=your-database;Persist Security Info=False;User ID=your-user;Password=your-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Portas da Aplicação
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000

# Email (se configurado)
# Email__Provider=smtp.gmail.com
# Email__Port=587
# Email__From=seu-email@gmail.com
# Email__Password=sua-senha-app
